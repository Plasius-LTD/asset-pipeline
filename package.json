{
  "name": "@plasius/asset-pipeline",
  "version": "0.3.0",
  "description": "State-machine and orchestration helpers for Plasius AI asset intake, validation, review, and promotion flows.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTORS.md",
    "docs",
    "legal"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./shader-lifecycle": {
      "node": {
        "import": {
          "types": "./dist/shader-lifecycle.d.ts",
          "default": "./dist/shader-lifecycle.js"
        },
        "require": {
          "types": "./dist/shader-lifecycle.d.cts",
          "default": "./dist/shader-lifecycle.cjs"
        }
      },
      "default": null
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "audit:all": "npm run typecheck && npm run audit:eslint && npm run audit:deps && npm run audit:npm && npm run audit:test",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/verify-public-package.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "assets",
    "pipeline",
    "state-machine",
    "promotion",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/asset-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/asset-pipeline/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/asset-pipeline#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "esbuild": "$esbuild",
    "minimatch": "^10.2.1",
    "postcss": "8.5.23"
  },
  "dependencies": {
    "@plasius/asset-contracts": "^0.3.1",
    "@plasius/asset-processing": "^0.2.0",
    "@plasius/gpu-shader": "^0.1.1"
  }
}
